# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Ingestion
INGEST_LOOKBACK_DAYS=365
# Keep false until candidate review has been validated against each source.
AUTO_PUBLISH_INGESTION=false

# Geography spine. Point this at an ArcGIS FeatureServer layer URL for the City
# of Charlotte's "Rezoning History" dataset (published on data.charlottenc.gov).
# Without it, `pnpm enrich:geography` expects a local .civiclens/geography-source.json
# export and leaves every record's location unconfirmed.
CHARLOTTE_REZONING_LAYER_URL=

# Plain-language drafts. Without a key, deterministic templates are used instead.
# Drafts are always created as "pending" and cannot appear publicly until an
# editor approves them in the workspace.
ENRICHMENT_API_KEY=
ENRICHMENT_BASE_URL=https://api.openai.com/v1
ENRICHMENT_MODEL=gpt-4o-mini
ENRICHMENT_LIMIT=60

# AI Provider Configuration
# Options: template (demo mode), openai (for Groq and OpenAI-compatible), freebuff
AI_PROVIDER=openai

# Groq Configuration (Recommended for Congressional App Challenge)
# Get your free API key from https://console.groq.com/ (no credit card required)
# Add your key below to enable real AI features
ENRICHMENT_API_KEY=your-groq-api-key-here
ENRICHMENT_BASE_URL=https://api.groq.com/openai/v1
ENRICHMENT_MODEL=openai/gpt-oss-20b
