{
  "name": "civiclens",
  "version": "0.2.0",
  "private": true,
  "scripts": {
    "setup": "pnpm install",
    "dev": "pnpm ensure:data && next dev",
    "dev:fast": "next dev",
    "build": "pnpm ensure:data && next build",
    "ensure:data": "node --import tsx scripts/prepare-data.ts",
    "serve": "pnpm build && pnpm start",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "check": "pnpm typecheck && pnpm build",
    "test": "node --import tsx --test src/lib/*.test.ts src/ingestion/*.test.ts",
    "ingest": "node --env-file-if-exists=.env.local --import tsx scripts/ingest.ts",
    "ingest:local": "node --import tsx scripts/ingest-local.ts",
    "ingest:publish": "AUTO_PUBLISH_INGESTION=true node --env-file-if-exists=.env.local --import tsx scripts/ingest.ts",
    "enrich": "pnpm enrich:geography && pnpm enrich:language",
    "enrich:geography": "node --env-file-if-exists=.env.local --import tsx scripts/enrich-geography.ts",
    "enrich:language": "node --env-file-if-exists=.env.local --import tsx scripts/enrich-plain-language.ts",
    "enrich:matters": "node --import tsx scripts/enrich-matters.ts",
    "changes": "node --import tsx scripts/detect-changes.ts",
    "approve:drafts": "node --env-file-if-exists=.env.local --import tsx scripts/approve-drafts.ts",
    "language": "pnpm enrich:language && pnpm approve:drafts",
    "collapse": "node --import tsx scripts/collapse-matters.ts",
    "deadlines": "node --import tsx scripts/report-deadlines.ts",
    "pipeline": "pnpm ingest:local && pnpm collapse && pnpm enrich:matters && pnpm changes && pnpm enrich"
  },
  "dependencies": {
    "@supabase/ssr": "^0.6.1",
    "@supabase/supabase-js": "^2.49.1",
    "@vercel/analytics": "^2.0.1",
    "lucide-react": "^0.468.0",
    "next": "^15.1.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "three": "^0.186.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "@types/react": "^19.0.3",
    "@types/react-dom": "^19.0.2",
    "@types/three": "^0.186.0",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.20.3",
    "typescript": "^5.7.2"
  },
  "packageManager": "pnpm@10.33.0"
}
